{
  "schemaVersion": 1,
  "name": "Supplier settlement",
  "currency": "CNY",
  "orders": {
    "path": "orders.xlsx",
    "sheet": "Orders",
    "headerRow": 1,
    "key": "A",
    "amount": "C",
    "label": "B",
    "headers": { "key": "Order ID", "amount": "Expected amount", "label": "Customer" }
  },
  "settlements": {
    "path": "settlements.xlsx",
    "sheet": "Settlements",
    "headerRow": 1,
    "key": "A",
    "amount": "B",
    "headers": { "key": "Order number", "amount": "Received amount" }
  },
  "match": { "trim": true, "caseSensitive": true, "settlementDuplicates": "reject", "tolerance": "0.00" },
  "template": {
    "path": "template.xlsx",
    "sheet": "Supplier settlement",
    "startRow": 8,
    "endRow": 27,
    "columns": { "key": "A", "label": "B", "expected": "C", "actual": "D", "difference": "E", "status": "F" }
  }
}
